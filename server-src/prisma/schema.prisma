generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                   @id @default(uuid())
  email                     String                   @unique
  name                      String?
  avatar                    String?
  passwordHash              String?
  googleId                  String?                  @unique
  yandexId                  String?                  @unique
  vkId                      String?                  @unique
  mailId                    String?                  @unique
  plan                      Plan                     @default(FREE)
  planExpiresAt             DateTime?
  isActive                  Boolean                  @default(true)
  emailVerified             Boolean                  @default(false)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  githubId                  String?                  @unique
  telegramId                String?                  @unique
  isAdmin                   Boolean                  @default(false)
  lastSeenAt                DateTime?
  autoRenew                 Boolean                  @default(false)
  autoRenewPayMethodId      String?
  emailVerifyTokenExpiresAt DateTime?
  emailVerifyTokenHash      String?
  passwordResetTokenHash       String?
  passwordResetTokenExpiresAt DateTime?
  referralBonusGranted      Boolean                  @default(false)
  referredById              String?
  // Which ad brought this sign-up, JSON, an estimate: see src/lib/ad-touch.js
  signupSource              String?
  planStartedAt             DateTime?
  aiUsage                   AiUsage[]
  chatSite                  ChatSite?
  folders                   Folder[]
  loginEvents               LoginEvent[]
  messengers                Messenger[]
  notes                     Note[]
  orgMemberships            OrgMember[]
  orgMessengerAssignments   OrgMessengerAssignment[]
  orgMessengerStats         OrgMessengerStat[]
  ownedOrganizations        Organization[]           @relation("OrgOwner")
  payments                  Payment[]
  promoRedemptions          PromoRedemption[]
  sessions                  Session[]
  syncSettings              SyncSettings?
  tickets                   Ticket[]
  unreadSummary             UnreadSummary?
  // Лента уведомлений на телефоне: включается самим пользователем в мобильном приложении.
  mobileFeedEnabled         Boolean         @default(false)
  mobileFeedItems           MobileFeedItem[]
  phoneKeys                 PhoneKey[]
  phoneReplies              PhoneReply[]
  usageStats                UsageStat[]
  referredBy                User?                    @relation("Referrals", fields: [referredById], references: [id])
  referrals                 User[]                   @relation("Referrals")
  workspaces                Workspace[]
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  // Mobile companion app sessions get their own device-count slot (see
  // utils/tokens.js MOBILE_DEVICE_LIMIT), independent of the existing
  // plan-based desktop/web MAX_DEVICES limit — logging into the mobile app
  // must never evict a FREE-plan user's only desktop session, or vice versa.
  isMobile     Boolean  @default(false)
  // Shown on the Admin "Mobile app" screen; filled from the X-Centrio-* headers the app sends.
  deviceName   String?
  appVersion   String?
  loginAt      DateTime @default(now())
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  folders   Folder[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Folder {
  id          String     @id @default(uuid())
  userId      String
  workspaceId String?
  name        String
  icon        String?    @default("folder")
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
}

model Messenger {
  id          String   @id @default(uuid())
  userId      String
  name        String
  url         String
  icon        String?
  color       String?
  isMuted     Boolean  @default(false)
  position    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  notifSound  String   @default("__default__")
  zoomLevel   Float    @default(1)
  folderId    String?
  workspaceId String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SyncSettings {
  id                String   @id @default(uuid())
  userId            String   @unique
  theme             String   @default("dark")
  accentColor       String   @default("#0078d4")
  density           String   @default("comfortable")
  language          String   @default("ru")
  sidebarPosition   String   @default("left")
  showTabs          Boolean  @default(true)
  notifications     Boolean  @default(true)
  notifSound        Boolean  @default(true)
  globalMuteAll     Boolean  @default(false)
  updatedAt         DateTime @updatedAt
  extra             Json?
  workspacesEnabled Boolean  @default(false)
  foldersEnabled    Boolean  @default(true)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Personal unread-summary snapshot for the mobile companion app's Feed
// screen. Deliberately separate from the sync.js Messenger/Folder tables
// (those are deleteMany+recreated wholesale on every structural sync;
// unread counts change far more often and independently of messenger
// config). One row per user, upserted by the desktop app whenever its own
// local unread state changes — see renderer/unread.js updateUnreadCount().
// Modeled on OrgMessengerStat below, minus the org scoping.
model UnreadSummary {
  id          String   @id @default(uuid())
  userId      String   @unique
  total       Int      @default(0)
  byMessenger Json     @default("[]")
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(uuid())
  userId        String
  amount        Float
  currency      String        @default("RUB")
  status        PaymentStatus @default(PENDING)
  provider      String
  providerPayId String?       @unique
  plan          Plan
  months        Int           @default(1)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  days          Int?
  orgId         String?
  seats         Int?
  invoice       Invoice?
  organization  Organization? @relation(fields: [orgId], references: [id])
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invoice {
  id               String       @id @default(uuid())
  number           Int          @unique @default(autoincrement())
  paymentId        String       @unique
  orgId            String
  amount           Float
  currency         String       @default("RUB")
  seats            Int
  months           Int
  issuedAt         DateTime     @default(now())
  paidAt           DateTime?
  confirmedByAdmin String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  cancelledAt      DateTime?
  cancelledBy      String?
  customerAddress  String?
  customerEmail    String?
  customerInn      String?
  customerKpp      String?
  customerName     String?
  organization     Organization @relation(fields: [orgId], references: [id])
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Organization {
  id                   String                   @id @default(uuid())
  name                 String
  slug                 String                   @unique
  ownerId              String
  tier                 OrgTier                  @default(START)
  seatLimit            Int                      @default(5)
  billingEmail         String?
  seatsExpiresAt       DateTime?
  autoRenewSeats       Boolean                  @default(false)
  autoRenewPayMethodId String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  billingAddress       String?
  billingInn           String?
  billingKpp           String?
  billingLegalName     String?
  forcedSettingsJson   Json?
  logoUrl              String?
  vpnConfigName        String?
  vpnConfigLink        String?
  invoices             Invoice[]
  auditLogs            OrgAuditLog[]
  invites              OrgInvite[]
  members              OrgMember[]
  messengerAssignments OrgMessengerAssignment[]
  messengerStats       OrgMessengerStat[]
  owner                User                     @relation("OrgOwner", fields: [ownerId], references: [id])
  payments             Payment[]
  alertSettingsJson   Json?
  alertTelegramChatId String?
  alertTelegramName   String?
  customLinks         OrgCustomLink[]
  quickReplies        OrgQuickReply[]
  orgAlerts           OrgAlert[]
  alertLinkCodes      OrgAlertLinkCode[]
  orgWorkspaces       OrgWorkspace[]
  orgFolders          OrgFolder[]
  tasks               OrgTask[]
  deviceKeys          OrgDeviceKey[]
  timeZone            String   @default("Europe/Moscow")
  workSchedule        Json?
  presence            OrgPresence[]
  presenceDaily       OrgPresenceDaily[]
  commands            OrgCommand[]
  notes               OrgNote[]
}

model OrgMember {
  id                  String          @id @default(uuid())
  orgId               String
  userId              String
  role                OrgRole         @default(MEMBER)
  status              OrgMemberStatus @default(ACTIVE)
  joinedAt            DateTime        @default(now())
  canAddOwnMessengers Boolean         @default(true)
  strictMode          Boolean         @default(false)
  organization        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model OrgInvite {
  id           String       @id @default(uuid())
  orgId        String
  email        String
  role         OrgRole      @default(MEMBER)
  tokenHash    String       @unique
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model OrgAuditLog {
  id           String       @id @default(uuid())
  orgId        String
  actorUserId  String
  action       String
  metaJson     Json?
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model OrgMessengerAssignment {
  id           String       @id @default(uuid())
  orgId        String
  userId       String
  name         String
  url          String
  icon         String?
  color        String?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  folderId String?
  useVpn   Boolean @default(false)
  paused   Boolean @default(false)
  credentials OrgCredential[]
}

model OrgMessengerStat {
  id            String       @id @default(uuid())
  orgId         String
  userId        String
  messengerKey  String
  messengerName String
  unreadCount   Int          @default(0)
  lastReadAt    DateTime?
  lastMessageAt DateTime?
  updatedAt     DateTime     @updatedAt
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, messengerKey])
  @@index([orgId])
  waitingSince     DateTime?
  alertSentAt      DateTime?
  alertCount       Int       @default(0)
  notLoggedInSince DateTime?
  loginState       String?
}

model UsageStat {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @default(now())
  service     String?
  appTime     Int      @default(0)
  serviceTime Int      @default(0)
  notifCount  Int      @default(0)
  msgSent     Int      @default(0)
  msgReceived Int      @default(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, date])
}

model AppNotification {
  id          String                @id @default(uuid())
  title       String
  body        String
  createdAt   DateTime              @default(now())
  imageUrl    String?
  actionLabel String?
  actionUrl   String?
  reads       AppNotificationRead[]
}

model AppNotificationRead {
  id             String          @id @default(uuid())
  notificationId String
  userId         String
  createdAt      DateTime        @default(now())
  notification   AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

model AutoRenewLog {
  id        String   @id @default(uuid())
  userId    String
  paymentId String?
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Visitor {
  id              String   @id @default(uuid())
  visitorId       String   @unique
  platform        String?
  appVersion      String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  sessions        Int      @default(1)
  messengersCount Int      @default(0)
  // 3.7.4: the account this install was signed in to, and when the Windows uninstaller removed it (lib/uninstall-mark.js)
  userId           String?
  uninstalledAt    DateTime?
  uninstallVersion String?

  @@index([lastSeenAt])
  @@index([userId])
  @@index([uninstalledAt])
}

model LoginEvent {
  id        String   @id @default(uuid())
  userId    String
  provider  String
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PromoCode {
  id          String            @id @default(uuid())
  code        String            @unique
  months      Int?
  maxUses     Int?
  usesCount   Int               @default(0)
  isActive    Boolean           @default(true)
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  days        Int?
  redemptions PromoRedemption[]
}

model PromoRedemption {
  id          String    @id @default(uuid())
  promoCodeId String
  userId      String
  createdAt   DateTime  @default(now())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
}

model DeviceTrial {
  id         String   @id @default(uuid())
  hardwareId String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model Ticket {
  id              String          @id @default(uuid())
  userId          String
  subject         String
  status          TicketStatus    @default(OPEN)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  telegramTopicId Int?
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        TicketMessage[]

  @@index([userId])
  @@index([status])
  category    String?
  botStage    String?
  typingUntil DateTime?
  typingBy    String?
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  isAdmin   Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  isBot       Boolean  @default(false)
  attachments String[] @default([])
}

model NewsPost {
  id                String   @id @default(uuid())
  slug              String?  @unique
  title             String
  telegramMessageId Int?
  createdAt         DateTime @default(now())

  @@index([createdAt])
}

model Broadcast {
  id          String    @id @default(uuid())
  subject     String
  bodyText    String
  audience    String    @default("ALL")
  status      String    @default("SENDING")
  totalCount  Int       @default(0)
  sentCount   Int       @default(0)
  failedCount Int       @default(0)
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdBy   String?

  @@index([createdAt])
}

model AiUsage {
  id           String   @id @default(uuid())
  userId       String
  month        String
  messagesUsed Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@index([userId])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("NOTE")
  title     String   @default("")
  body      String?
  items     Json?
  pinned    Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  color     String?
  archived  Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, position])
}

model ChatSite {
  id            String             @id @default(uuid())
  userId        String             @unique
  domain        String
  widgetToken   String             @unique @default(uuid())
  name          String             @default("Мой сайт")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  widgetColor   String             @default("#5AA9FF")
  widgetLogoUrl String?
  conversations ChatConversation[]
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([widgetToken])
}

model ChatConversation {
  id             String        @id @default(uuid())
  siteId         String
  visitorId      String
  visitorName    String?
  visitorContact String?
  status         String        @default("OPEN")
  lastMessageAt  DateTime      @default(now())
  createdAt      DateTime      @default(now())
  site           ChatSite      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  messages       ChatMessage[]

  @@index([siteId, lastMessageAt])
  @@index([siteId, visitorId])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  fromVisitor    Boolean          @default(true)
  body           String
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model DownloadStat {
  id        String   @id @default(uuid())
  platform  String   @unique
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum Plan {
  FREE
  PRO
  TEAM
}

enum OrgTier {
  START
  BUSINESS
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgMemberStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}


model OrgCustomLink {
  id           String       @id @default(uuid())
  orgId        String
  name         String
  url          String
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model OrgQuickReply {
  id           String       @id @default(uuid())
  orgId        String
  title        String
  text         String
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, sortOrder])
}

model OrgAlert {
  id            String       @id @default(uuid())
  orgId         String
  userId        String
  messengerKey  String
  messengerName String
  waitingSince  DateTime
  waitedMinutes Int
  createdAt     DateTime     @default(now())
  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model OrgAlertLinkCode {
  id           String       @id @default(uuid())
  orgId        String
  codeHash     String       @unique
  expiresAt    DateTime
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model OrgTask {
  id           String           @id @default(uuid())
  orgId        String
  assigneeId   String
  createdById  String
  title        String
  notes        String?
  priority     String           @default("NORMAL")
  status       String           @default("OPEN")
  dueAt        DateTime?
  doneAt       DateTime?
  seenAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  comments     OrgTaskComment[]

  @@index([orgId, assigneeId, status])
}

model OrgTaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  task      OrgTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model OrgWorkspace {
  id           String       @id @default(uuid())
  orgId        String
  userId       String
  name         String
  color        String?
  position     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  folders      OrgFolder[]

  @@index([orgId, userId])
}

model OrgFolder {
  id           String        @id @default(uuid())
  orgId        String
  userId       String
  workspaceId  String?
  name         String
  position     Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workspace    OrgWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([orgId, userId])
}

model OrgDeviceKey {
  id           String          @id @default(uuid())
  orgId        String
  userId       String
  deviceId     String
  publicKey    String
  name         String?
  createdAt    DateTime        @default(now())
  lastSeenAt   DateTime        @default(now())
  organization Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  credentials  OrgCredential[]

  @@unique([userId, deviceId])
  @@index([orgId, userId])
}

model OrgCredential {
  id           String                 @id @default(uuid())
  orgId        String
  assignmentId String
  deviceKeyId  String
  blob         String
  setById      String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  assignment   OrgMessengerAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  deviceKey    OrgDeviceKey           @relation(fields: [deviceKeyId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, deviceKeyId])
  @@index([orgId])
}

// Тексты уведомлений для ленты в мобильном приложении (только чтение). Хранятся до 48 часов, не больше 300 на человека,
// удаляются сразу при выключении ленты. См. src/routes/mobile-feed.js.
model MobileFeedItem {
  id            String   @id @default(uuid())
  userId        String
  messengerId   String
  messengerName String
  title         String
  body          String
  // End-to-end encrypted feed: `enc` is the sealed {title, body} for ONE phone (phoneDeviceId); title/body stay empty then.
  ref           String?
  phoneDeviceId String?
  enc           String?
  canReply      Boolean  @default(false)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, phoneDeviceId, ref])
}

// A phone's public key for the end-to-end encrypted feed. `proof` is an HMAC with the secret from the desktop's QR code,
// which only the desktop and the phone that scanned it know: the desktop trusts the key only if the proof checks out.
model PhoneKey {
  id          String    @id @default(uuid())
  userId      String
  deviceId    String
  name        String
  pub         String
  proof       String
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
}

// A reply typed on the phone, sealed for the desktop; the desktop sends it into the chat and reports the result.
model PhoneReply {
  id            String   @id @default(uuid())
  userId        String
  phoneDeviceId String
  ref           String
  desktopKeyId  String
  enc           String
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  resultAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Yandex Metrica connection of the platform owner (single row, id "main").
model MetrikaConnection {
  id              String    @id
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  login           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model MetrikaInsight {
  id           String   @id @default(uuid())
  counterId    String
  summaryJson  Json
  analysisJson Json
  createdAt    DateTime @default(now())

  @@index([counterId, createdAt])
}

model AdTouch {
  ipHash    String   @id
  source    String?
  campaign  String?
  content   String?
  term      String?
  landing   String?
  ymClientId String?
  yclid     String?
  createdAt DateTime @default(now())
}

// TEAM control (2026-11-08): presence, daily rollups, per-device commands, notes.
model OrgPresence {
  id                String       @id @default(uuid())
  orgId             String
  userId            String
  deviceKeyId       String?
  at                DateTime     @default(now())
  open              Boolean
  idleSec           Int
  frontAssignmentId String?
  unreadTotal       Int          @default(0)
  organization      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, userId, at])
  @@index([at])
}

model OrgPresenceDaily {
  id             String       @id @default(uuid())
  orgId          String
  userId         String
  day            String
  activeMin      Float        @default(0)
  firstAt        DateTime?
  lastAt         DateTime?
  reactionSecSum Int          @default(0)
  reactionCount  Int          @default(0)
  overThreshold  Int          @default(0)
  organization   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId, day])
  @@index([day])
}

model OrgCommand {
  id          String       @id @default(uuid())
  orgId       String
  userId      String
  deviceKeyId String
  kind        String
  payload     Json?
  createdById String
  createdAt   DateTime     @default(now())
  doneAt      DateTime?
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([deviceKeyId, doneAt])
  @@index([orgId, userId, createdAt])
}

model OrgNote {
  id          String        @id @default(uuid())
  orgId       String
  toUserId    String?
  text        String
  createdById String
  createdAt   DateTime      @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reads       OrgNoteRead[]

  @@index([orgId, createdAt])
}

model OrgNoteRead {
  id     String   @id @default(uuid())
  noteId String
  userId String
  readAt DateTime @default(now())
  note   OrgNote  @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
}
