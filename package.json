{
	"name": "messengerapp",
	"productName": "Centrio",
	"version": "2.5.3",
	"description": "All messengers in one app",
	"author": {
		"name": "Centrio",
		"email": "support@centrio.me"
	},
	"main": "main.js",
	"scripts": {
		"build:renderer": "node build-renderer.js",
		"watch:renderer": "node build-renderer.js --watch",
		"start": "npm run build:renderer && electron .",
		"dev": "npm run build:renderer && electron .",
		"build": "npm run build:renderer && electron-builder",
		"build:win": "rimraf dist && npm run build:renderer && electron-builder --win",
		"build:mac": "rimraf dist && npm run build:renderer && electron-builder --mac",
		"build:linux": "rimraf dist && npm run build:renderer && electron-builder --linux",
		"publish": "npm run build:win && node scripts/publish.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/inter": "^5.3.0",
		"electron": "^39.8.10",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.25.12",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.8.0",
		"pg": "^8.21.0",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"ssh2": "^1.17.0",
		"ssh2-sftp-client": "^12.1.1"
	},
	"dependencies": {
		"adm-zip": "^0.6.0",
		"dotenv": "^17.4.1",
		"electron-log": "^5.4.3",
		"electron-store": "^10.0.1",
		"electron-updater": "^6.8.3",
		"node-machine-id": "^1.1.12",
		"sound-play": "^1.1.0",
		"uuid": "^14.0.0"
	},
	"build": {
		"appId": "me.centrio.app",
		"productName": "Centrio",
		"copyright": "Copyright © 2026 Centrio",
		"directories": {
			"output": "dist"
		},
		"compression": "maximum",
		"files": [
			"**/*",
			"!dist/**/*",
			"!dist-*/**/*",
			"!landing/**/*",
			"!node_modules/.cache/**/*",
			"!*.md",
			"!*.log",
			"!.git/**/*",
			"!.github/**/*",
			"!.claude/**/*",
			"!**/*.py",
			"!telegram-claude/**/*",
			"!scripts/**/*",
			"!renderer/**/*.js",
			"!renderer.js",
			"!renderer.js.map",
			"!bundle.js.map"
		],
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "assets/logotype.ico"
		},
		"mac": {
			"target": [
				{
					"target": "dmg",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "assets/icon.png",
			"category": "public.app-category.productivity",
			"darkModeSupport": true,
			"hardenedRuntime": false,
			"publish": {
				"provider": "generic",
				"url": "https://download.centrio.me/mac/"
			}
		},
		"dmg": {
			"title": "Centrio ${version}",
			"icon": "assets/icon.png",
			"window": {
				"width": 540,
				"height": 380
			}
		},
		"linux": {
			"target": [
				{
					"target": "deb",
					"arch": [
						"x64"
					]
				},
				{
					"target": "AppImage",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "assets/icon.png",
			"category": "Network",
			"executableArgs": [
				"--no-sandbox"
			],
			"mimeTypes": [
				"x-scheme-handler/centrio"
			],
			"publish": {
				"provider": "generic",
				"url": "https://download.centrio.me/linux/"
			}
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Centrio",
			"perMachine": true
		},
		"asarUnpack": [
			"assets/sounds/**/*"
		],
		"publish": {
			"provider": "generic",
			"url": "https://download.centrio.me/"
		},
		"protocols": [
			{
				"name": "centrio-auth",
				"schemes": [
					"centrio-auth"
				]
			}
		]
	}
}
